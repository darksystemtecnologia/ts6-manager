# ==========================================
# Estágio 1: Builder (Compilação e Dependências)
# ==========================================
FROM node:22-alpine AS builder

WORKDIR /app

# Pin do pnpm na versão 9 ou 10 estável para evitar incompatibilidades
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

# Instala ferramentas nativas de compilação exigidas por bibliotecas Node
RUN apk add --no-cache python3 make g++

# Copia os arquivos de manifesto do projeto
COPY package*.json pnpm-lock.yaml* ./

# Instala todas as dependências (dev + prod)
RUN pnpm install --frozen-lockfile

# Copia todo o código-fonte restante
COPY . .

# Executa o build usando pnpm diretamente
RUN pnpm run build


# ==========================================
# Estágio 2: Produção (Imagem Final)
# ==========================================
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

# Ativa o pnpm no estágio de execução
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

# Copia arquivos de manifesto e instala apenas dependências de produção
COPY package*.json pnpm-lock.yaml* ./
RUN pnpm install --prod --frozen-lockfile

# Copia os artefatos gerados pelo build
COPY --from=builder /app/dist ./dist

USER node

EXPOSE 3000

CMD ["node", "dist/main.js"]
