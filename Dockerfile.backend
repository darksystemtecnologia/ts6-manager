# ==========================================
# Estágio 1: Builder (Geração do Prisma e Build)
# ==========================================
FROM node:22-alpine AS builder

WORKDIR /app

# Ativa o pnpm em versão fixa
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

# Instala ferramentas nativas e OpenSSL (exigido pelo Prisma Engine no Alpine)
RUN apk add --no-cache python3 make g++ openssl

# Copia manifestos de dependências da raiz e configurações de workspace
COPY package*.json pnpm-lock.yaml* pnpm-workspace.yaml* ./
COPY packages/backend/package.json ./packages/backend/

# Instala todas as dependências (dev + prod)
RUN pnpm install --frozen-lockfile

# Copia todo o código-fonte
COPY . .

# Variável de ambiente fictícia para permitir o 'prisma generate' durante a compilação
ENV DATABASE_URL="postgresql://dummy:dummy@localhost:5432/dummy"

# 1. Gera o cliente do Prisma usando npx para garantir a localização do binário
RUN npx prisma generate --schema=packages/backend/prisma/schema.prisma

# 2. Compila a aplicação backend
RUN pnpm --filter @ts6/backend run build


# ==========================================
# Estágio 2: Produção (Imagem de Execução)
# ==========================================
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

# Instala dependência do OpenSSL necessária para execução em produção
RUN apk add --no-cache openssl

# Ativa o pnpm
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

# Copia manifestos de dependências
COPY package*.json pnpm-lock.yaml* pnpm-workspace.yaml* ./
COPY packages/backend/package.json ./packages/backend/

# Instala apenas dependências de produção
RUN pnpm install --prod --frozen-lockfile

# Copia os artefatos compilados e os arquivos gerados do Prisma do estágio Builder
COPY --from=builder /app/packages/backend/dist ./packages/backend/dist
COPY --from=builder /app/packages/backend/generated ./packages/backend/generated
COPY --from=builder /app/packages/backend/prisma ./packages/backend/prisma

USER node

EXPOSE 3000

CMD ["node", "packages/backend/dist/main.js"]
