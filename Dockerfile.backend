# ==========================================
# Estágio 1: Builder
# ==========================================
FROM node:22-alpine AS builder

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
RUN apk add --no-cache python3 make g++

COPY package*.json pnpm-lock.yaml* ./
COPY packages/backend/package.json ./packages/backend/

RUN pnpm install --frozen-lockfile

COPY . .

# 1. Gera o cliente Prisma antes do build
RUN pnpm --filter @ts6/backend exec prisma generate

# 2. Executa o build do backend
RUN pnpm --filter @ts6/backend run build


# ==========================================
# Estágio 2: Produção
# ==========================================
FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production

RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

COPY package*.json pnpm-lock.yaml* ./
COPY packages/backend/package.json ./packages/backend/

RUN pnpm install --prod --frozen-lockfile

# Copia os artefatos compilados e o Prisma gerado
COPY --from=builder /app/packages/backend/dist ./packages/backend/dist
COPY --from=builder /app/packages/backend/generated ./packages/backend/generated

USER node

EXPOSE 3000

CMD ["node", "packages/backend/dist/main.js"]
