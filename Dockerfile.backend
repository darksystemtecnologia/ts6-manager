# syntax=docker/dockerfile:1.4
FROM node:20-slim AS base
RUN corepack enable && corepack prepare pnpm@9 --activate

# 1. Dependências mínimas de runtime + yt-dlp standalone
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      openssl \
      ffmpeg \
      ca-certificates \
      curl \
    && curl -L https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp -o /usr/local/bin/yt-dlp \
    && chmod a+rx /usr/local/bin/yt-dlp \
    && apt-get purge -y --auto-remove curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 2. Estágio de Build (Instala python temporariamente só para compilar pacotes C++ se necessário)
FROM base AS build
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ && rm -rf /var/lib/apt/lists/*

COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @ts6/common run build
RUN pnpm --filter @ts6/backend exec prisma generate
RUN pnpm --filter @ts6/backend run build

# Isola apenas as dependências de produção
RUN pnpm --filter @ts6/backend deploy --prod /prod/backend

# 3. Estágio de Produção (Imagem final ultra leve)
FROM base AS production
ENV NODE_ENV=production
WORKDIR /app/packages/backend

COPY --from=build /prod/backend /app/packages/backend
COPY --from=build /app/packages/common/dist /app/packages/common/dist
COPY --from=build /app/packages/backend/dist /app/packages/backend/dist
COPY --from=build /app/packages/backend/generated /app/packages/backend/generated

RUN mkdir -p data /data/music && \
    mkdir -p /root/.config/yt-dlp && \
    echo "--js-runtimes node --remote-components ejs:npm" > /root/.config/yt-dlp/config

EXPOSE 3001
ENV SIDECAR_URL=http://ts6-sidecar:9800
CMD ["sh", "-c", "npx prisma db push --skip-generate && npx prisma db seed || true && node dist/index.js"]
