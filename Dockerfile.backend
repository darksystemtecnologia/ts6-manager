# syntax=docker/dockerfile:1.4
FROM node:20-slim AS base
RUN corepack enable && corepack prepare pnpm@9 --activate

# 1. Dependências mínimas de runtime + yt-dlp standalone
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      openssl \
      ffmpeg \
      ca-certificates \
      curl \
    && curl -L https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp -o /usr/local/bin/yt-dlp \
    && chmod a+rx /usr/local/bin/yt-dlp \
    && apt-get purge -y --auto-remove curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 2. Estágio de Build
FROM base AS build
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ && rm -rf /var/lib/apt/lists/*

# Copia todos os fontes do monorepo
COPY . .

# Instala todas as dependências do monorepo sem abortar se o lockfile tiver pequena variação
RUN pnpm install

# Compila o pacote compartilhado primeiro
RUN pnpm --filter @ts6/common run build

# Gerar o Prisma ANTES do build do backend
RUN pnpm --filter @ts6/backend exec prisma generate

# Compila o backend
RUN pnpm --filter @ts6/backend run build

# 3. Estágio de Produção
FROM base AS production
ENV NODE_ENV=production
WORKDIR /app

# Copia todo o monorepo compilado e dependências preparadas do build
COPY --from=build /app /app

# Configura diretórios e yt-dlp
RUN mkdir -p /app/packages/backend/data /data/music && \
    mkdir -p /root/.config/yt-dlp && \
    echo "--js-runtimes node --remote-components ejs:npm" > /root/.config/yt-dlp/config

WORKDIR /app/packages/backend

EXPOSE 3001
ENV SIDECAR_URL=http://ts6-sidecar:9800

# Executa as migrations/seed e inicia a aplicação
CMD ["sh", "-c", "npx prisma db push --skip-generate && (npx prisma db seed || true) && node dist/index.js"]
