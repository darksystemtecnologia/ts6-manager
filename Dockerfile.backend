# syntax=docker/dockerfile:1.4
FROM node:20-slim AS base
RUN corepack enable && corepack prepare pnpm@9 --activate

# 1. Dependências de runtime necessárias (incluindo python3) + yt-dlp
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      python3 \
      openssl \
      ffmpeg \
      ca-certificates \
      curl \
    && curl -L https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp -o /usr/local/bin/yt-dlp \
    && chmod a+rx /usr/local/bin/yt-dlp \
    && apt-get purge -y --auto-remove curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 2. Estágio de Build (Instala ferramentas de compilação C++ se necessário)
FROM base AS build
RUN apt-get update && apt-get install -y --no-install-recommends make g++ && rm -rf /var/lib/apt/lists/*

# Copia todo o monorepo
COPY . .

# Instala dependências
RUN pnpm install

# Compila os pacotes na ordem correta
RUN pnpm --filter @ts6/common run build
RUN pnpm --filter @ts6/backend exec prisma generate
RUN pnpm --filter @ts6/backend run build

# 3. Estágio Final
FROM base AS runner
WORKDIR /app

# Copia o projeto construído
COPY --from=build /app /app

# Cria diretórios de dados e config do yt-dlp
RUN mkdir -p /app/packages/backend/data /data/music && \
    mkdir -p /root/.config/yt-dlp && \
    echo "--js-runtimes node --remote-components ejs:npm" > /root/.config/yt-dlp/config

WORKDIR /app/packages/backend

EXPOSE 3001

CMD ["sh", "-c", "npx prisma db push --skip-generate && (npx prisma db seed || true) && node dist/index.js"]
