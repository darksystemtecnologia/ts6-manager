# Estágio de Build para instalar dependências e yt-dlp
FROM python:3.11-alpine AS builder

# Instala ferramentas de download
RUN apk add --no-舆-cache curl

# Baixa a versão mais recente do yt-dlp
RUN curl -L https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp -o /usr/local/bin/yt-dlp && \
    chmod a+rx /usr/local/bin/yt-dlp

# Estágio Final Minimalista
FROM python:3.11-alpine

# Instala apenas o ffmpeg necessário
RUN apk add --no-cache ffmpeg

# Copia o yt-dlp do estágio de build
COPY --from=builder /usr/local/bin/yt-dlp /usr/local/bin/yt-dlp

WORKDIR /app
# Adicione a instrução de execução do seu sidecar aqui
CMD ["python", "main.py"]
