# syntax=docker/dockerfile:1.4
FROM golang:1.22-alpine AS build
WORKDIR /src
RUN apk add --no-cache git
COPY packages/sidecar/go.mod packages/sidecar/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download
COPY packages/sidecar/main.go .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /sidecar main.go

# Estágio final ultraleve (~20MB)
FROM alpine:3.19
RUN apk add --no-cache ffmpeg ca-certificates tzdata
COPY --from=build /sidecar /usr/local/bin/sidecar
EXPOSE 9800
CMD ["sidecar"]
